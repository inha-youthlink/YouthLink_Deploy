# 평가 일반 설정 (비밀값 금지)
# rag 모드·route가 호출하는 RAG Service (클러스터 내부 주소)
RAG_BASE_URL=http://youthlink-rag:8000
GEN_MODEL=bedrock-gpt-5.6-luna
JUDGE_MODEL=bedrock-gpt-5.6-luna
EMBEDDING_MODEL=bedrock-titan-embed-v2
# run --baseline 전용. RAG chat_model과 같게 둔다
BASELINE_MODEL=bedrock-gpt-5.6-luna
# RAG와 같은 API 키(키당 동시 8)를 나눠 쓰므로 RAG 몫 4를 남긴다
LLM_MAX_CONCURRENCY=4
# bedrock-* 모델용 프록시 주소(OPENAI_BASE_URL)는 공개 저장소에 두지 않고 ragas-eval-secrets에 넣는다. 없으면 OpenAI 기본 주소로 가서 실패한다
