# ETL 일반 설정 (비밀값 금지)
YOUTH_API_PAGE_SIZE=100
# RAG의 embedding_model(기본 bedrock-titan-embed-v2)과 같아야 검색이 맞는다
LITELLM_EMBEDDING_MODEL=bedrock-titan-embed-v2
# 프록시 주소·키(LITELLM_BASE_URL, LITELLM_API_KEY)는 공개 저장소에 두지 않고 etl-secrets에 넣는다
# 웹 파이프라인 AI 검증용 chat 모델 별칭. 비우면 AI_SHADOW 단계가 실패한다
LITELLM_CHAT_MODEL=bedrock-gpt-5.6-luna
